# =============================================================================
# BookMeBadminton - Production Environment Configuration Template
# Copy this file to .env or configure in your deployment provider's secret manager.
# NEVER commit sensitive production credentials or actual secret values to version control.
# =============================================================================

# 1. Database Configuration (Required)
# Managed PostgreSQL connection string for Prisma ORM.
# For standard VPS/Docker container:
DATABASE_URL="postgresql://bookme_user:your_secure_password@localhost:5432/bookme_badminton?schema=public"
# For Serverless/PGBouncer setups (e.g. Neon, Supabase, AWS RDS Proxy), configure pooler URL:
# DATABASE_URL="postgresql://user:password@pooler.neon.tech/bookme_badminton?sslmode=require&pgbouncer=true"

# 2. Application Runtime Environment
NODE_ENV="production" # Use "production" for production deployments, "development" for local work
PORT=3000
NEXT_PUBLIC_APP_URL="https://badminton.yourdomain.com" # Canonical domain with HTTPS

# 3. Scheduled Tasks & Cron Security (Required in Production)
# Secret key used to authorize automated background jobs (e.g. /api/cron/reminders).
# Generate securely via: openssl rand -base64 32
# Request Header: Authorization: Bearer <CRON_SECRET> or x-cron-secret: <CRON_SECRET>
CRON_SECRET="generate_a_random_32_character_secret_string"

# 4. Web Push Notification Configuration (Optional - Production Only)
# Required only if native browser push notification infrastructure is activated:
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
# VAPID_PRIVATE_KEY="your_vapid_private_key_here"
# VAPID_SUBJECT="mailto:admin@yourdomain.com"

# 5. VietQR Payment Merchant Configuration (Optional)
# Used to generate real QR codes for venue bank transfers in Vietnam.
# VIETQR_BANK_ID="970422" # e.g. MB Bank (970422), Vietcombank (970436), Techcombank (970407)
# VIETQR_ACCOUNT_NO="0123456789"
# VIETQR_ACCOUNT_NAME="CONG TY TNHH BOOKME BADMINTON"
